{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\Thargelion AB\\Tharga.Neurolito.Agent\\logs\\neurolito-agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Ollama": {
    "Address": "http://localhost:11434",
    "//Models": "Installed automatically at startup if missing, e.g. [ \"llama3.1:8b-instruct-q4_K_M\" ]. Empty installs nothing.",
    "Models": []
  },
  "Tharga": {
    "Communication": {
      "ServerAddress": "https://neurolito.com/"
    }
  },
  "AllowedHosts": "*"
}